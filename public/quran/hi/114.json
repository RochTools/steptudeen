{"id":114,"name":"الناس","transliteration":"An-Nas","translation":"अल-नास","type":"meccan","total_verses":6,"verses":[{"id":1,"text":"قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ","translation":"(हे नबी!) कहो कि मैं इन्सानों के पालनहार की शरण में आता हूँ।","transliteration":"Qul aAAoothu birabbi alnnasi"},{"id":2,"text":"مَلِكِ ٱلنَّاسِ","translation":"जो सारे इन्सानों का स्वामी है।","transliteration":"Maliki alnnasi"},{"id":3,"text":"إِلَٰهِ ٱلنَّاسِ","translation":"जो सारे इन्सानों का पूज्य है।","transliteration":"Ilahi alnnasi"},{"id":4,"text":"مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ","translation":"भ्रम डालने वाले और छुप जाने वाले (राक्षस) की बुराई से।","transliteration":"Min sharri alwaswasi alkhannasi"},{"id":5,"text":"ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ","translation":"जो लोगों के दिलों में भ्रम डालता रहता है।","transliteration":"Allathee yuwaswisu fee sudoori alnnasi"},{"id":6,"text":"مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ","translation":"जो जिन्नों में से है और मनुष्यों में से भी।","transliteration":"Mina aljinnati wa alnnasm"}]}