{"id":112,"name":"الإخلاص","transliteration":"Al-Ikhlas","translation":"अल-इखलास","type":"meccan","total_verses":4,"verses":[{"id":1,"text":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","translation":"(हे ईश दूत!) कह दोः अल्लाह अकेला है।","transliteration":"Qul huwa Allahu ahadun"},{"id":2,"text":"ٱللَّهُ ٱلصَّمَدُ","translation":"अल्लाह निःछिद्र है।","transliteration":"Allahu alssamadu"},{"id":3,"text":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","translation":"न उसकी कोई संतान है और न वह किसी की संतान है।","transliteration":"Lam yalid walam yooladu"},{"id":4,"text":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","translation":"और न उसके बराबर कोई है।","transliteration":"Walam yakun lahu kufuwan ahadun"}]}