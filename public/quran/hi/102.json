{"id":102,"name":"التكاثر","transliteration":"At-Takathur","translation":"अत-तकाथुर","type":"meccan","total_verses":8,"verses":[{"id":1,"text":"أَلۡهَىٰكُمُ ٱلتَّكَاثُرُ","translation":"तुम्हें अधिक (धन) के लोभ ने मगन कर दिया।","transliteration":"Alhakumu alttakathuru"},{"id":2,"text":"حَتَّىٰ زُرۡتُمُ ٱلۡمَقَابِرَ","translation":"यहाँ तक कि तुम क़ब्रिस्तान जा पहुँचे।","transliteration":"Hatta zurtumu almaqabira"},{"id":3,"text":"كَلَّا سَوۡفَ تَعۡلَمُونَ","translation":"निश्चय तुम्हें ज्ञान हो जायेगा।","transliteration":"Kalla sawfa taAAlamoona"},{"id":4,"text":"ثُمَّ كَلَّا سَوۡفَ تَعۡلَمُونَ","translation":"फिर निश्चय ही तुम्हें ज्ञान हो जायेगा।","transliteration":"Thumma kalla sawfa taAAlamoona"},{"id":5,"text":"كَلَّا لَوۡ تَعۡلَمُونَ عِلۡمَ ٱلۡيَقِينِ","translation":"वास्तव में, यदि तुम्हें विश्वास होता (तो ऐसा न करते)।","transliteration":"Kalla law taAAlamoona AAilma alyaqeeni"},{"id":6,"text":"لَتَرَوُنَّ ٱلۡجَحِيمَ","translation":"तुम नरक को अवश्य देखोगे।","transliteration":"Latarawunna aljaheema"},{"id":7,"text":"ثُمَّ لَتَرَوُنَّهَا عَيۡنَ ٱلۡيَقِينِ","translation":"फिर उसे विश्वास की आँख से देखोगे।","transliteration":"Thumma latarawunnaha AAayna alyaqeeni"},{"id":8,"text":"ثُمَّ لَتُسۡـَٔلُنَّ يَوۡمَئِذٍ عَنِ ٱلنَّعِيمِ","translation":"फिर उस दिन तुमसे सुख सम्पदा के विषय में अवश्य पूछ गछ होगी।","transliteration":"Thumma latusalunna yawmaithin AAani alnnaAAeemi"}]}