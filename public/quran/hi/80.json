{"id":80,"name":"عبس","transliteration":"'Abasa","translation":"अबस","type":"meccan","total_verses":42,"verses":[{"id":1,"text":"عَبَسَ وَتَوَلَّىٰٓ","translation":"(नबी ने) त्योरी चढ़ाई तथा मुँह फेर लिया।","transliteration":"AAabasa watawalla"},{"id":2,"text":"أَن جَآءَهُ ٱلۡأَعۡمَىٰ","translation":"इस कारण कि उसके पास एक अँधा आया।","transliteration":"An jaahu alaAAma"},{"id":3,"text":"وَمَا يُدۡرِيكَ لَعَلَّهُۥ يَزَّكَّىٰٓ","translation":"और तुम क्या जानो शायद वह पवित्रता प्राप्त करे।","transliteration":"Wama yudreeka laAAallahu yazzakka"},{"id":4,"text":"أَوۡ يَذَّكَّرُ فَتَنفَعَهُ ٱلذِّكۡرَىٰٓ","translation":"या नसीह़त ग्रहण करे, जो उसे लाभ देती।","transliteration":"Aw yaththakkaru fatanfaAAahu alththikra"},{"id":5,"text":"أَمَّا مَنِ ٱسۡتَغۡنَىٰ","translation":"परन्तु, जो विमुख (निश्चिन्त) है।","transliteration":"Amma mani istaghna"},{"id":6,"text":"فَأَنتَ لَهُۥ تَصَدَّىٰ","translation":"तुम उनकी ओर ध्यान दे रहे हो।","transliteration":"Faanta lahu tasadda"},{"id":7,"text":"وَمَا عَلَيۡكَ أَلَّا يَزَّكَّىٰ","translation":"जबकि तुमपर कोई दोष नहीं, यदि वह पवित्रता ग्रहण न करे।","transliteration":"Wama AAalayka alla yazzakka"},{"id":8,"text":"وَأَمَّا مَن جَآءَكَ يَسۡعَىٰ","translation":"तथा जो तुम्हारे पास दौड़ता आया।","transliteration":"Waamma man jaaka yasAAa"},{"id":9,"text":"وَهُوَ يَخۡشَىٰ","translation":"और वह डर भी रहा है।","transliteration":"Wahuwa yakhsha"},{"id":10,"text":"فَأَنتَ عَنۡهُ تَلَهَّىٰ","translation":"तुम उसकी ओर ध्यान नहीं देते।","transliteration":"Faanta AAanhu talahha"},{"id":11,"text":"كَلَّآ إِنَّهَا تَذۡكِرَةٞ","translation":"कदापि ये न करो, ये (अर्थात क़ुर्आन) एक स्मृति (याद दहानी) है।","transliteration":"Kalla innaha tathkiratun"},{"id":12,"text":"فَمَن شَآءَ ذَكَرَهُۥ","translation":"अतः, जो चाहे स्मरण (याद) करे।","transliteration":"Faman shaa thakarahu"},{"id":13,"text":"فِي صُحُفٖ مُّكَرَّمَةٖ","translation":"माननीय शास्त्रों में है।","transliteration":"Fee suhufin mukarramatin"},{"id":14,"text":"مَّرۡفُوعَةٖ مُّطَهَّرَةِۭ","translation":"जो ऊँचे तथा पवित्र हैं।","transliteration":"MarfooAAatin mutahharatin"},{"id":15,"text":"بِأَيۡدِي سَفَرَةٖ","translation":"ऐसे लेखकों (फ़रिश्तों) के हाथों में है।","transliteration":"Biaydee safaratin"},{"id":16,"text":"كِرَامِۭ بَرَرَةٖ","translation":"जो सम्मानित और आदरणीय हैं।","transliteration":"Kiramin bararatin"},{"id":17,"text":"قُتِلَ ٱلۡإِنسَٰنُ مَآ أَكۡفَرَهُۥ","translation":"इन्सान मारा जाये, वह कितना कृतघ्न (नाशुक्रा) है।","transliteration":"Qutila alinsanu ma akfarahu"},{"id":18,"text":"مِنۡ أَيِّ شَيۡءٍ خَلَقَهُۥ","translation":"उसे किस वस्तु से (अल्लाह) ने पैदा किया","transliteration":"Min ayyi shayin khalaqahu"},{"id":19,"text":"مِن نُّطۡفَةٍ خَلَقَهُۥ فَقَدَّرَهُۥ","translation":"उसे वीर्य से पैदा किया, फिर उसका भाग्य बनाया।","transliteration":"Min nutfatin khalaqahu faqaddarahu"},{"id":20,"text":"ثُمَّ ٱلسَّبِيلَ يَسَّرَهُۥ","translation":"फिर उसके लिए मार्ग सरल किया।","transliteration":"Thumma alssabeela yassarahu"},{"id":21,"text":"ثُمَّ أَمَاتَهُۥ فَأَقۡبَرَهُۥ","translation":"फिर मौत दी, फिर समाधि में डाल दिया।","transliteration":"Thumma amatahu faaqbarahu"},{"id":22,"text":"ثُمَّ إِذَا شَآءَ أَنشَرَهُۥ","translation":"फिर जब चाहेगा, उसे जीवित कर लेगा।","transliteration":"Thumma itha shaa ansharahu"},{"id":23,"text":"كَلَّا لَمَّا يَقۡضِ مَآ أَمَرَهُۥ","translation":"वस्तुतः, उसने उसकी आज्ञा का पालन नहीं किया।","transliteration":"Kalla lamma yaqdi ma amarahu"},{"id":24,"text":"فَلۡيَنظُرِ ٱلۡإِنسَٰنُ إِلَىٰ طَعَامِهِۦٓ","translation":"इन्सान अपने भोजन की ओर ध्यान दे।","transliteration":"Falyanthuri alinsanu ila taAAamihi"},{"id":25,"text":"أَنَّا صَبَبۡنَا ٱلۡمَآءَ صَبّٗا","translation":"हमने मूसलाधार वर्षा की।","transliteration":"Anna sababna almaa sabban"},{"id":26,"text":"ثُمَّ شَقَقۡنَا ٱلۡأَرۡضَ شَقّٗا","translation":"फिर धरती को चीरा फाड़ा।","transliteration":"Thumma shaqaqna alarda shaqqan"},{"id":27,"text":"فَأَنۢبَتۡنَا فِيهَا حَبّٗا","translation":"फिर उससे अन्न उगाया।","transliteration":"Faanbatna feeha habban"},{"id":28,"text":"وَعِنَبٗا وَقَضۡبٗا","translation":"तथा अंगूर और तरकारियाँ।","transliteration":"WaAAinaban waqadban"},{"id":29,"text":"وَزَيۡتُونٗا وَنَخۡلٗا","translation":"तथा ज़ैतून एवं खजूर।","transliteration":"Wazaytoonan wanakhlan"},{"id":30,"text":"وَحَدَآئِقَ غُلۡبٗا","translation":"तथा घने बाग़।","transliteration":"Wahadaiqa ghulban"},{"id":31,"text":"وَفَٰكِهَةٗ وَأَبّٗا","translation":"एवं फल तथा वनस्पतियाँ।","transliteration":"Wafakihatan waabban"},{"id":32,"text":"مَّتَٰعٗا لَّكُمۡ وَلِأَنۡعَٰمِكُمۡ","translation":"तुम्हारे तथा तुम्हारे पशुओं के लिए।","transliteration":"MataAAan lakum walianAAamikum"},{"id":33,"text":"فَإِذَا جَآءَتِ ٱلصَّآخَّةُ","translation":"तो जब कान फाड़ देने वाली (प्रलय) आ जायेगी।","transliteration":"Faitha jaati alssakhkhatu"},{"id":34,"text":"يَوۡمَ يَفِرُّ ٱلۡمَرۡءُ مِنۡ أَخِيهِ","translation":"उस दिन इन्सान अपने भाई से भागेगा।","transliteration":"Yawma yafirru almaro min akheehi"},{"id":35,"text":"وَأُمِّهِۦ وَأَبِيهِ","translation":"तथा अपने माता और पिता से।","transliteration":"Waommihi waabeehi"},{"id":36,"text":"وَصَٰحِبَتِهِۦ وَبَنِيهِ","translation":"एवं अपनी पत्नी तथा अपने पुत्रों से।","transliteration":"Wasahibatihi wabaneehi"},{"id":37,"text":"لِكُلِّ ٱمۡرِيٕٖ مِّنۡهُمۡ يَوۡمَئِذٖ شَأۡنٞ يُغۡنِيهِ","translation":"प्रत्येक व्यक्ति को उस दिन अपनी पड़ी होगी।","transliteration":"Likulli imriin minhum yawmaithin shanun yughneehi"},{"id":38,"text":"وُجُوهٞ يَوۡمَئِذٖ مُّسۡفِرَةٞ","translation":"उस दिन बहुत से चेहरे उज्ज्वल होंगे।","transliteration":"Wujoohun yawmaithin musfiratun"},{"id":39,"text":"ضَاحِكَةٞ مُّسۡتَبۡشِرَةٞ","translation":"हंसते एवं प्रसन्न होंगे।","transliteration":"Dahikatun mustabshiratun"},{"id":40,"text":"وَوُجُوهٞ يَوۡمَئِذٍ عَلَيۡهَا غَبَرَةٞ","translation":"तथा बहुत-से चेहरों पर धूल पड़ी होगी।","transliteration":"Wawujoohun yawmaithin AAalayha ghabaratun"},{"id":41,"text":"تَرۡهَقُهَا قَتَرَةٌ","translation":"उनपर कालिमा छाई होगी।","transliteration":"Tarhaquha qataratun"},{"id":42,"text":"أُوْلَـٰٓئِكَ هُمُ ٱلۡكَفَرَةُ ٱلۡفَجَرَةُ","translation":"वही काफ़िर और कुकर्मी लोग हैं।","transliteration":"Olaika humu alkafaratu alfajaratu"}]}