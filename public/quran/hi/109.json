{"id":109,"name":"الكافرون","transliteration":"Al-Kafirun","translation":"अल-काफ़िरुन","type":"meccan","total_verses":6,"verses":[{"id":1,"text":"قُلۡ يَـٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","translation":"(हे नबी!) कह दोः हे काफ़िरो","transliteration":"Qul ya ayyuha alkafiroona"},{"id":2,"text":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","translation":"मैं उन (मूर्तियों) को नहीं पूजता, जिन्हें तुम पूजते हो।","transliteration":"La aAAbudu ma taAAbudoona"},{"id":3,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","translation":"और न तुम उसे पूजते हो, जिसे मैं पूजता हूँ।","transliteration":"Wala antum AAabidoona ma aAAbudu"},{"id":4,"text":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","translation":"और न मैं उसे पूजूँगा, जिसे तुम पूजते हो।","transliteration":"Wala ana AAabidun ma AAabadtum"},{"id":5,"text":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","translation":"और न तुम उसे पूजोगे, जिसे मैं पूजता हूँ।","transliteration":"Wala antum AAabidoona ma aAAbudu"},{"id":6,"text":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","translation":"तुम्हारे लिए तम्हारा धर्म तथा मेरे लिए मेरा धर्म है।","transliteration":"Lakum deenukum waliya deeni"}]}