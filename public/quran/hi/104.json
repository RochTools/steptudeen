{"id":104,"name":"الهمزة","transliteration":"Al-Humazah","translation":"अल-हुमज़ह","type":"meccan","total_verses":9,"verses":[{"id":1,"text":"وَيۡلٞ لِّكُلِّ هُمَزَةٖ لُّمَزَةٍ","translation":"विनाश हो उस व्यक्ति का, जो कचोके लगाता रहता है और चौटे करता रहता है।","transliteration":"Waylun likulli humazatin lumazatin"},{"id":2,"text":"ٱلَّذِي جَمَعَ مَالٗا وَعَدَّدَهُۥ","translation":"जिसने धन एकत्र किया और उसे गिन-गिन कर रखा।","transliteration":"Allathee jamaAAa malan waAAaddadahu"},{"id":3,"text":"يَحۡسَبُ أَنَّ مَالَهُۥٓ أَخۡلَدَهُۥ","translation":"क्या वह समझता है कि उसका धन उसे संसार में सदा रखेगा","transliteration":"Yahsabu anna malahu akhladahu"},{"id":4,"text":"كَلَّاۖ لَيُنۢبَذَنَّ فِي ٱلۡحُطَمَةِ","translation":"कदापि ऐसा नहीं होगा। वह अवश्य ही 'ह़ुतमा' में फेंका जायेगा।","transliteration":"Kalla layunbathanna fee alhutamati"},{"id":5,"text":"وَمَآ أَدۡرَىٰكَ مَا ٱلۡحُطَمَةُ","translation":"और तुम क्या जानो कि 'ह़ुतमा' क्या है","transliteration":"Wama adraka ma alhutamatu"},{"id":6,"text":"نَارُ ٱللَّهِ ٱلۡمُوقَدَةُ","translation":"वह अल्लाह की भड़काई हुई अग्नि है।","transliteration":"Naru Allahi almooqadatu"},{"id":7,"text":"ٱلَّتِي تَطَّلِعُ عَلَى ٱلۡأَفۡـِٔدَةِ","translation":"जो दिलों तक जा पहूँचेगी।","transliteration":"Allatee tattaliAAu AAala alafidati"},{"id":8,"text":"إِنَّهَا عَلَيۡهِم مُّؤۡصَدَةٞ","translation":"वह, उसमें बन्द कर दिये जायेंगे।","transliteration":"lnnaha AAalayhim musadatun"},{"id":9,"text":"فِي عَمَدٖ مُّمَدَّدَةِۭ","translation":"लँबे-लँबे स्तंभों में।","transliteration":"Fee AAamadin mumaddadatin"}]}